---
// src/components/ExperienceTimeline.astro
import experiences from '../data/experience.json';
---

<section id="experience" class="py-24 sm:py-32 bg-gray-50/60 dark:bg-gray-900/50 transition-colors duration-300">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 text-xs font-bold ring-1 ring-blue-500/20 mb-4">
        <span>💼 Work & Career Track</span>
      </div>
      <h2 class="text-3xl font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
        Career & Engineering Milestones
      </h2>
      <p class="mt-4 text-base sm:text-lg leading-relaxed text-gray-600 dark:text-gray-300">
        A track record of building production RAG pipelines, enterprise web applications, and dynamic developer tools.
      </p>
    </div>

    <div class="mx-auto max-w-3xl relative border-l-2 border-blue-500/40 dark:border-blue-500/30 ml-4 sm:ml-32 space-y-10">
      {experiences.map((exp, idx) => (
        <div class="relative pl-8 sm:pl-10 group">
          {/* Timeline Glowing Dot */}
          <div class="absolute -left-[9px] top-2 h-4 w-4 rounded-full bg-blue-600 ring-4 ring-white dark:ring-gray-900 group-hover:scale-125 group-hover:bg-emerald-500 transition-all shadow-md" />

          {/* Card */}
          <div class="p-6 sm:p-7 rounded-3xl bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl shadow-lg border border-gray-200/80 dark:border-gray-700/70 hover:border-blue-500/40 dark:hover:border-blue-400/40 hover:shadow-2xl transition-all duration-300">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
              <h3 class="text-xl font-extrabold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                {exp.role}
              </h3>
              <span class="text-xs font-extrabold px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/80 text-blue-700 dark:text-blue-300 ring-1 ring-blue-500/20 w-fit shadow-sm">
                {exp.period}
              </span>
            </div>
            
            <p class="text-sm font-bold text-blue-600 dark:text-blue-400 mb-3 flex items-center gap-1.5">
              <span>{exp.company}</span>
            </p>
            
            <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 leading-relaxed mb-5">
              {exp.description}
            </p>

            <div class="flex flex-wrap gap-2 pt-2 border-t border-gray-100 dark:border-gray-700/60">
              {exp.skills.map((skill) => (
                <span class="px-3 py-1 rounded-full bg-gray-100 dark:bg-gray-700/70 text-gray-800 dark:text-gray-200 text-xs font-semibold ring-1 ring-gray-200 dark:ring-gray-600/50 hover:bg-blue-50 dark:hover:bg-blue-950/50 transition-colors">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
