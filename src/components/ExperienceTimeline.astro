---
// src/components/ExperienceTimeline.astro
import experiences from '../data/experience.json';
---

<section id="experience" class="py-24 sm:py-32 bg-gray-50 dark:bg-gray-900/50">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center mb-16">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
        Career & Engineering Milestones
      </h2>
      <p class="mt-4 text-lg leading-8 text-gray-600 dark:text-gray-300">
        A track record of building production RAG pipelines, enterprise web applications, and developer tools.
      </p>
    </div>

    <div class="mx-auto max-w-3xl relative border-l-2 border-blue-500/30 dark:border-blue-400/20 ml-4 sm:ml-32 space-y-12">
      {experiences.map((exp, idx) => (
        <div class="relative pl-8 sm:pl-10 group">
          {/* Timeline Dot */}
          <div class="absolute -left-[9px] top-1.5 h-4 w-4 rounded-full bg-blue-600 ring-4 ring-white dark:ring-gray-900 group-hover:scale-125 transition-transform" />

          {/* Card */}
          <div class="p-6 rounded-2xl bg-white dark:bg-gray-800 shadow-md border border-gray-200 dark:border-gray-700/60 hover:shadow-xl transition-all">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white">{exp.role}</h3>
              <span class="text-xs font-semibold px-3 py-1 rounded-full bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300 w-fit">
                {exp.period}
              </span>
            </div>
            
            <p class="text-sm font-semibold text-blue-600 dark:text-blue-400 mb-3">{exp.company}</p>
            <p class="text-base text-gray-600 dark:text-gray-300 leading-relaxed mb-4">{exp.description}</p>

            <div class="flex flex-wrap gap-2">
              {exp.skills.map((skill) => (
                <span class="px-2.5 py-1 rounded-md bg-gray-100 dark:bg-gray-700/80 text-gray-700 dark:text-gray-300 text-xs font-medium">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
