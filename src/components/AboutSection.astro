---
// src/components/AboutSection.astro
---

<section id="about" class="relative py-24 sm:py-32 overflow-hidden dark:bg-gray-900">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-12 gap-y-16 items-center">
      
      <!-- Text Content -->
      <div>
        <h2 class="text-base font-semibold leading-7 text-blue-600 dark:text-blue-400">
          About Me
        </h2>
        <p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          Bridging Systems with Intelligence
        </p>
        
        <div class="mt-8 space-y-6 text-lg leading-8 text-gray-600 dark:text-gray-400">
          <p>
            I'm a <strong>Full-stack Developer</strong> currently building impact-driven platforms at <strong>Akvo</strong>. My expertise lies at the intersection of traditional enterprise scaling and modern AI innovation.
          </p>
          <p>
            Over the past year, I've focused on mastering <strong>Retrieval-Augmented Generation (RAG)</strong> and <strong>Agentic Tooling</strong>. I believe the future of software lies in creating systems that don't just store data, but intelligently bridge the gap between knowledge and action.
          </p>
          <p>
            When I'm not architecting data pipelines or refining UI/UX patterns, you can find me exploring the intricate rhythms of <strong>Balinese music</strong> or traveling to find new perspectives. I believe a well-rounded life fuels better code.
          </p>
        </div>

        <!-- My Values / Philosophy -->
        <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="rounded-xl bg-gray-50 dark:bg-gray-800/50 p-6 border border-gray-100 dark:border-gray-700">
            <h4 class="font-bold text-gray-900 dark:text-white">Precision</h4>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Building robust, scalable architectures that stand the test of time.</p>
          </div>
          <div class="rounded-xl bg-gray-50 dark:bg-gray-800/50 p-6 border border-gray-100 dark:border-gray-700">
            <h4 class="font-bold text-gray-900 dark:text-white">Innovation</h4>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Leveraging AI to solve real-world problems in human-centric ways.</p>
          </div>
        </div>
      </div>

      <!-- Visual Side / Modern Engineering Competencies Card -->
      <div class="relative">
        <div class="rounded-3xl backdrop-blur-xl bg-white/70 dark:bg-gray-800/70 p-8 shadow-2xl ring-1 ring-gray-200/80 dark:ring-gray-700/80 border border-gray-100 dark:border-gray-700/60 space-y-6">
          
          <!-- Header -->
          <div class="flex items-center justify-between pb-4 border-b border-gray-200/80 dark:border-gray-700/80">
            <div>
              <h3 class="text-lg font-bold text-gray-900 dark:text-white">Core Competencies</h3>
              <p class="text-xs text-gray-500 dark:text-gray-400">Engineering Focus & Architecture Stack</p>
            </div>
            <span class="inline-flex items-center rounded-full bg-blue-100 dark:bg-blue-950/80 px-3 py-1 text-xs font-bold text-blue-700 dark:text-blue-300">
              ⚡ Production Specs
            </span>
          </div>

          <!-- Feature Cards Grid -->
          <div class="space-y-4">
            {/* Card 1: Enterprise RAG */}
            <div class="p-4 rounded-2xl bg-gradient-to-r from-emerald-500/10 to-blue-500/10 border border-emerald-500/20 dark:border-emerald-400/20">
              <div class="flex items-center gap-3">
                <div class="p-2.5 rounded-xl bg-emerald-600 text-white shadow-md">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-sm font-bold text-gray-900 dark:text-white">Retrieval-Augmented Generation</h4>
                  <p class="text-xs text-gray-600 dark:text-gray-300 mt-0.5">Semantic Search, Vector DB Indexing & LLM Agents</p>
                </div>
              </div>
            </div>

            {/* Card 2: Full-Stack Architecture */}
            <div class="p-4 rounded-2xl bg-gradient-to-r from-blue-500/10 to-indigo-500/10 border border-blue-500/20 dark:border-blue-400/20">
              <div class="flex items-center gap-3">
                <div class="p-2.5 rounded-xl bg-blue-600 text-white shadow-md">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V6z" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-sm font-bold text-gray-900 dark:text-white">Full-Stack Platform Engineering</h4>
                  <p class="text-xs text-gray-600 dark:text-gray-300 mt-0.5">React 19, Astro v5, Node.js, Python & PHP/Laravel</p>
                </div>
              </div>
            </div>

            {/* Card 3: Dynamic Data Pipelines */}
            <div class="p-4 rounded-2xl bg-gradient-to-r from-amber-500/10 to-rose-500/10 border border-amber-500/20 dark:border-amber-400/20">
              <div class="flex items-center gap-3">
                <div class="p-2.5 rounded-xl bg-amber-600 text-white shadow-md">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-sm font-bold text-gray-900 dark:text-white">Document & Form Generators</h4>
                  <p class="text-xs text-gray-600 dark:text-gray-300 mt-0.5">WeasyPrint PDF, Jinja2 & Dynamic JSON Form Editors</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom Footer Card -->
          <div class="pt-4 border-t border-gray-200/80 dark:border-gray-700/80 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="h-10 w-10 rounded-full bg-gradient-to-br from-blue-600 to-emerald-600 flex items-center justify-center text-white font-black text-xs shadow-md">
                AKVO
              </div>
              <div>
                <p class="text-xs font-bold text-gray-900 dark:text-white">Primary Focus</p>
                <p class="text-xs text-gray-500 dark:text-gray-400">Enterprise AI & Scalable Web Apps</p>
              </div>
            </div>
            <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
              Active
            </span>
          </div>
        </div>

        <!-- Ambient Glow Circles -->
        <div class="absolute -top-6 -right-6 h-32 w-32 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-6 -left-6 h-40 w-40 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
      </div>

    </div>
  </div>
</section>
