---
// src/components/ProjectsSection.astro
import projectsData from "../data/projects.json";
import ProjectGrid from "./ProjectGrid";

const allProjects = projectsData.projects;
// In the future, we might want to only show featured projects on the homepage
const featuredProjects = allProjects.filter((p) => p.featured);
const otherProjects = allProjects.filter((p) => !p.featured);

// Combine them to show featured first
const projects = [...featuredProjects, ...otherProjects];
---

<section id="projects" class="relative py-24 sm:py-32 dark:bg-gray-900 transition-colors duration-300">
  <!-- Background decoration - Ambient glow -->
  <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
    <div
      class="absolute left-1/2 top-1/4 -translate-x-1/2 blur-3xl opacity-20 dark:opacity-30"
      aria-hidden="true"
    >
      <div
        class="aspect-[1318/752] w-[82.375rem] bg-gradient-to-r from-blue-600 via-indigo-600 to-emerald-500"
        style="clip-path: polygon(73.6% 51.7%, 91.7% 11.8%, 100% 46.4%, 97.4% 82.2%, 92.5% 84.9%, 75.7% 64%, 55.3% 47.5%, 46.5% 49.4%, 45% 62.9%, 50.3% 87.2%, 21.3% 64.1%, 0.1% 100%, 5.4% 51.1%, 21.4% 63.9%, 58.9% 0.2%, 73.6% 51.7%)"
      >
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <!-- Section Header -->
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 text-xs font-bold ring-1 ring-emerald-500/20 mb-4">
        <span>🚀 Portfolio Ecosystem</span>
      </div>
      <h2
        class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
      >
        Featured & Enterprise Projects
      </h2>
      <p class="mt-4 text-base sm:text-lg leading-relaxed text-gray-600 dark:text-gray-300">
        A curated selection of dynamic repositories spanning enterprise RAG systems, AST document printers, dynamic form editors, and personal full-stack applications.
      </p>
    </div>

    <!-- Projects Grid (Interactive React Component) -->
    <ProjectGrid initialProjects={projects} client:load />

    {/* View All Projects CTA */}
    <div class="mt-16 flex justify-center">
      <a
        href={import.meta.env.BASE_URL + "/projects"}
        class="inline-flex items-center gap-x-2.5 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 px-8 py-4 text-sm font-bold text-white shadow-xl shadow-blue-500/20 hover:scale-[1.03] active:scale-[0.98] transition-all"
      >
        <span>View Full Repository Catalogue</span>
        <span aria-hidden="true" class="text-base">&rarr;</span>
      </a>
    </div>
  </div>
</section>
