---
// src/components/Hero.astro
const resumeLink = import.meta.env.BASE_URL + "/Galih-Pratama-CV.pdf";
const profilePic = import.meta.env.BASE_URL + "/profile.png";
---

<section id="hero" class="relative isolate overflow-hidden dark:bg-gray-900 transition-colors duration-300">
  <!-- Background gradient - Ambient Blur -->
  <div
    class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80 pointer-events-none"
    aria-hidden="true"
  >
    <div
      class="relative left-[calc(50%-11rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-blue-600 via-indigo-500 to-emerald-500 opacity-25 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem] dark:opacity-35"
      style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
    >
    </div>
  </div>

  <div class="py-24 sm:py-32 lg:py-36">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-12 lg:gap-x-12 lg:items-center">
        <!-- Text Content -->
        <div class="lg:col-span-7">
          <!-- Animated Live Status Pulse Badge -->
          <div
            class="inline-flex items-center gap-2.5 rounded-full px-4 py-2 text-xs font-bold backdrop-blur-md bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 ring-1 ring-inset ring-emerald-500/30 mb-8 shadow-sm hover:ring-emerald-500/50 transition-all cursor-default"
          >
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
            </span>
            <span>Available for Select Advisory & Enterprise RAG Projects</span>
          </div>

          <h1
            class="text-5xl font-extrabold tracking-tight text-gray-900 sm:text-6xl lg:text-7xl dark:text-white leading-[1.1]"
          >
            Hi, I'm <span
              class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-indigo-500 to-emerald-500 dark:from-blue-400 dark:via-indigo-400 dark:to-emerald-400"
              >Wayan Galih Pratama</span
            >
          </h1>

          <p
            class="mt-6 text-xl sm:text-2xl leading-relaxed text-gray-800 dark:text-gray-200 font-bold flex items-center gap-2"
          >
            <span>Full-Stack & RAG AI Systems Engineer</span>
            <span class="inline-flex items-center rounded-md bg-blue-100 dark:bg-blue-950/80 px-2 py-0.5 text-xs font-extrabold text-blue-700 dark:text-blue-300 ring-1 ring-blue-500/20">@ Akvo 🌍</span>
          </p>

          <p class="mt-4 text-base sm:text-lg leading-relaxed text-gray-600 dark:text-gray-300 max-w-2xl">
            Architecting high-performance web applications and enterprise retrieval-augmented generation (RAG) pipelines. Bridging complex multi-modal data with intelligent AI workflows.
          </p>

          <!-- Bento Quick Stats Grid -->
          <div class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-3.5 max-w-2xl">
            <div class="p-4 rounded-2xl bg-white/70 dark:bg-gray-800/70 border border-gray-200/80 dark:border-gray-700/60 backdrop-blur-md shadow-sm hover:shadow-md hover:border-blue-500/40 dark:hover:border-blue-400/40 transition-all group">
              <div class="flex items-center justify-between text-gray-400 group-hover:text-blue-500 transition-colors">
                <p class="text-xs font-semibold text-gray-500 dark:text-gray-400">GitHub Repos</p>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              </div>
              <p class="text-lg font-black text-gray-900 dark:text-white mt-1">37 Synced</p>
            </div>
            <div class="p-4 rounded-2xl bg-white/70 dark:bg-gray-800/70 border border-gray-200/80 dark:border-gray-700/60 backdrop-blur-md shadow-sm hover:shadow-md hover:border-emerald-500/40 dark:hover:border-emerald-400/40 transition-all group">
              <div class="flex items-center justify-between text-gray-400 group-hover:text-emerald-500 transition-colors">
                <p class="text-xs font-semibold text-gray-500 dark:text-gray-400">Specialization</p>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <p class="text-lg font-black text-gray-900 dark:text-white mt-1">RAG & AI Tools</p>
            </div>
            <div class="p-4 rounded-2xl bg-white/70 dark:bg-gray-800/70 border border-gray-200/80 dark:border-gray-700/60 backdrop-blur-md shadow-sm hover:shadow-md hover:border-amber-500/40 dark:hover:border-amber-400/40 transition-all group">
              <div class="flex items-center justify-between text-gray-400 group-hover:text-amber-500 transition-colors">
                <p class="text-xs font-semibold text-gray-500 dark:text-gray-400">Interests</p>
                <span class="text-xs">🎵</span>
              </div>
              <p class="text-lg font-black text-gray-900 dark:text-white mt-1">Balinese Music</p>
            </div>
            <div class="p-4 rounded-2xl bg-white/70 dark:bg-gray-800/70 border border-gray-200/80 dark:border-gray-700/60 backdrop-blur-md shadow-sm hover:shadow-md hover:border-indigo-500/40 dark:hover:border-indigo-400/40 transition-all group">
              <div class="flex items-center justify-between text-gray-400 group-hover:text-indigo-500 transition-colors">
                <p class="text-xs font-semibold text-gray-500 dark:text-gray-400">Location</p>
                <span class="text-xs">🏝️</span>
              </div>
              <p class="text-lg font-black text-gray-900 dark:text-white mt-1">Indonesia</p>
            </div>
          </div>

          <!-- CTA Buttons -->
          <div class="mt-10 flex flex-wrap items-center gap-4">
            <a
              href="#projects"
              class="rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 px-6 py-3.5 text-sm font-bold text-white shadow-xl shadow-blue-500/25 transition-all hover:scale-[1.03] active:scale-[0.98] flex items-center gap-2"
            >
              <span>Explore Projects</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            <a
              href={resumeLink}
              target="_blank"
              class="rounded-xl px-6 py-3.5 text-sm font-bold text-gray-900 dark:text-white ring-1 ring-inset ring-gray-300 dark:ring-gray-700 hover:ring-blue-500 dark:hover:ring-blue-400 backdrop-blur-md bg-white/80 dark:bg-gray-800/80 transition-all hover:scale-[1.03] active:scale-[0.98] flex items-center gap-2 shadow-sm"
            >
              <span>Download CV</span>
              <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
            </a>
            <a
              href="#contact"
              class="text-sm font-bold text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors ml-2 flex items-center gap-1 group"
            >
              <span>Direct Email</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Glassmorphism Profile Avatar Card -->
        <div class="lg:col-span-5 mt-16 lg:mt-0">
          <div class="relative">
            <!-- Ambient Glow Circles -->
            <div class="absolute inset-0 -z-10 pointer-events-none">
              <div
                class="absolute top-1/4 left-1/4 h-72 w-72 rounded-full bg-blue-500/20 blur-3xl animate-pulse"
              >
              </div>
              <div
                class="absolute bottom-1/4 right-1/4 h-72 w-72 rounded-full bg-emerald-500/20 blur-3xl animate-pulse"
                style="animation-delay: 1.5s;"
              >
              </div>
            </div>

            <!-- Glass Card Container -->
            <div class="relative mx-auto max-w-md">
              <div
                class="rounded-3xl backdrop-blur-xl bg-white/70 dark:bg-gray-800/70 p-8 shadow-2xl ring-1 ring-white/60 dark:ring-white/10 border border-gray-200/60 dark:border-gray-700/60 transition-all hover:shadow-blue-500/10 hover:border-blue-500/30"
              >
                <!-- Avatar Circle with Glowing Ring -->
                <div
                  class="mx-auto h-72 w-72 sm:h-80 sm:w-80 rounded-full bg-gradient-to-br from-blue-500 via-indigo-500 to-emerald-500 p-1.5 shadow-2xl transition-transform duration-500 hover:scale-[1.03]"
                >
                  <img
                    src={profilePic}
                    alt="Wayan Galih Pratama Profile Picture"
                    class="object-cover object-center w-full h-full rounded-full bg-gray-900 border-2 border-white dark:border-gray-800 shadow-inner"
                  />
                </div>

                <!-- Tech Stack Badges -->
                <div class="mt-8 flex flex-wrap gap-2 justify-center">
                  <span class="inline-flex items-center rounded-full bg-blue-50 dark:bg-blue-950/70 px-3.5 py-1.5 text-xs font-bold text-blue-700 dark:text-blue-300 ring-1 ring-blue-500/30 shadow-sm">
                    React 19
                  </span>
                  <span class="inline-flex items-center rounded-full bg-emerald-50 dark:bg-emerald-950/70 px-3.5 py-1.5 text-xs font-bold text-emerald-700 dark:text-emerald-300 ring-1 ring-emerald-500/30 shadow-sm">
                    Python RAG
                  </span>
                  <span class="inline-flex items-center rounded-full bg-indigo-50 dark:bg-indigo-950/70 px-3.5 py-1.5 text-xs font-bold text-indigo-700 dark:text-indigo-300 ring-1 ring-indigo-500/30 shadow-sm">
                    Astro v5
                  </span>
                  <span class="inline-flex items-center rounded-full bg-amber-50 dark:bg-amber-950/70 px-3.5 py-1.5 text-xs font-bold text-amber-800 dark:text-amber-300 ring-1 ring-amber-500/30 shadow-sm">
                    Agentic MCP
                  </span>
                  <span class="inline-flex items-center rounded-full bg-purple-50 dark:bg-purple-950/70 px-3.5 py-1.5 text-xs font-bold text-purple-700 dark:text-purple-300 ring-1 ring-purple-500/30 shadow-sm">
                    Node.js
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

