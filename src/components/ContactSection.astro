---
// src/components/ContactSection.astro
const EMAIL = "wgprtm@gmail.com";
const LINKEDIN_URL = "https://www.linkedin.com/in/wayan-galih-pratama-1512b7101";
---

<section id="contact" class="relative py-24 sm:py-32 dark:bg-gray-900 transition-colors duration-300 overflow-hidden">
  <!-- Ambient background glow -->
  <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[40rem] h-[20rem] bg-gradient-to-t from-blue-500/10 via-emerald-500/10 to-transparent blur-3xl opacity-50"></div>
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 text-xs font-bold ring-1 ring-blue-500/20 mb-4">
        <span>📬 Get In Touch</span>
      </div>
      <h2 class="text-3xl font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
        Let's Build Something Exceptional Together
      </h2>
      <p class="mt-4 text-base sm:text-lg leading-relaxed text-gray-600 dark:text-gray-300">
        Have an enterprise engineering inquiry, a RAG system collaboration, or want to discuss modern web architecture? Send a message directly.
      </p>
    </div>

    <div class="mt-12 mx-auto max-w-xl p-8 sm:p-10 rounded-3xl bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl border border-gray-200/80 dark:border-gray-700/70 shadow-2xl text-center space-y-6">
      <div class="inline-flex items-center justify-center p-4 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 text-white shadow-lg shadow-blue-500/25">
        <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
        </svg>
      </div>

      <div>
        <h3 class="text-xl font-extrabold text-gray-900 dark:text-white">Direct Email Contact</h3>
        <p class="mt-1 text-base font-bold text-blue-600 dark:text-blue-400 select-all">{EMAIL}</p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a
          href={`mailto:${EMAIL}?subject=Project%20Inquiry%20-%20Portfolio`}
          class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold transition-all hover:scale-[1.03] active:scale-[0.98] shadow-lg shadow-blue-500/20 flex items-center justify-center gap-2"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Send Email
        </a>

        <button
          id="copy-email-btn"
          data-email={EMAIL}
          class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-gray-100 dark:bg-gray-700/80 text-gray-900 dark:text-white font-bold hover:bg-gray-200 dark:hover:bg-gray-600 transition-all hover:scale-[1.03] active:scale-[0.98] flex items-center justify-center gap-2 shadow-sm border border-gray-200 dark:border-gray-600/50"
        >
          <svg class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span id="copy-btn-text">Copy Address</span>
        </button>
      </div>

      <div class="pt-6 border-t border-gray-200/80 dark:border-gray-700/80 flex items-center justify-center gap-6">
        <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400 transition-colors flex items-center gap-2 text-sm font-bold">
          <svg class="w-5 h-5 fill-current text-blue-600 dark:text-blue-400" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.535-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.735 7 2.479v6.756z"/>
          </svg>
          Connect on LinkedIn
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-btn-text');

  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email') || '';
      try {
        await navigator.clipboard.writeText(email);
        copyText.textContent = 'Copied!';
        copyBtn.classList.add('bg-green-600', 'text-white');
        setTimeout(() => {
          copyText.textContent = 'Copy Address';
          copyBtn.classList.remove('bg-green-600', 'text-white');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy email', err);
      }
    });
  }
</script>

