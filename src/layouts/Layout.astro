---
// src/layouts/Layout.astro
import MobileMenu from "../components/MobileMenu.jsx";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const { title } = Astro.props;

const menuItems = [
  { name: "Home", href: import.meta.env.BASE_URL },
  { name: "Projects", href: import.meta.env.BASE_URL + "/projects" },
  { name: "Contact", href: import.meta.env.BASE_URL + "/contact" },
];

const favicon = import.meta.env.BASE_URL + "/favicon.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Wayan Galih Pratama - Full-Stack & RAG AI Systems Engineer specializing in high-performance web applications, agentic tools, and enterprise architecture."
    />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={favicon} />

    <!-- OpenGraph / Social Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Wayan Galih Pratama - Full-Stack & RAG AI Systems Engineer." />
    <meta property="og:image" content={import.meta.env.BASE_URL + "/profile.png"} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="Wayan Galih Pratama - Full-Stack & RAG AI Systems Engineer." />

    <!-- JSON-LD Structured Data for Search Engines -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Wayan Galih Pratama",
        "jobTitle": "Full-Stack & AI Systems Engineer",
        "url": "https://github.com/wayangalihpratama",
        "sameAs": [
          "https://www.linkedin.com/in/wayan-galih-pratama-1512b7101",
          "https://github.com/wayangalihpratama"
        ]
      }
    </script>

    <!-- Inline script to prevent flash of wrong theme -->
    <script is:inline>
      const theme = localStorage.getItem("theme");
      const systemPrefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)"
      ).matches;
      if (theme === "dark" || (!theme && systemPrefersDark)) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>
  <body class="bg-white dark:bg-gray-900 transition-colors duration-300">
    <!-- Navigation -->
    <MobileMenu menuItems={menuItems} client:load />

    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Smooth scroll behavior -->
    <script>
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener("click", function (e) {
          const href = this.getAttribute("href");
          if (href === "#") return;

          e.preventDefault();
          const target = document.querySelector(href);
          if (target) {
            target.scrollIntoView({
              behavior: "smooth",
              block: "start",
            });
          }
        });
      });
    </script>
  </body>
</html>
