---
// src/pages/contact.astro
import Layout from "../layouts/Layout.astro";
import ContactSection from "../components/ContactSection.astro";
---

<Layout title="Contact - Wayan Galih Pratama">
  <main class="min-h-svh bg-white dark:bg-gray-900">
    <!-- Header -->
    <div class="relative py-24 sm:py-32">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="max-w-2xl">
          <a href={import.meta.env.BASE_URL} class="text-sm font-semibold leading-7 text-blue-600 dark:text-blue-400 hover:text-blue-500 transition-colors mb-8 inline-block">
            ← Back to Home
          </a>
          <h2 class="text-base font-semibold leading-7 text-green-700 dark:text-green-400">
            Contact
          </h2>
          <p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
            Get in Touch
          </p>
          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-400">
            Whether you have a question about a project, a job opportunity, or just want to say hi, my inbox is always open.
          </p>
        </div>
      </div>
    </div>

    <!-- Contact Form Section -->
    <div class="px-6 lg:px-8 pb-24 sm:pb-32">
      <div class="mx-auto max-w-7xl">
        <ContactSection />
      </div>
    </div>
  </main>
</Layout>
